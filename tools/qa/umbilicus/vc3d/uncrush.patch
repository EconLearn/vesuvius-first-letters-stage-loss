+    CHECK(errorMm(uncrushed) < 1.6);                  // 20 seed median 0.85 mm, p90 1.02 mm
+    CHECK(errorMm(uncrushed) < errorMm(unchanged));   // 20 seed range 0.74 to 1.23 against 1.78 to 6.12 mm
+}
